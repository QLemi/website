{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharedFiles collection",
  "type": "object",
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": [
        "url",
        "alternatives",
        "local"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "local": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "\\.webp$"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "characterId": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "enum": [
            "killer",
            "survivor"
          ]
        }
      }
    }
  },
  "additionalProperties": false
}
